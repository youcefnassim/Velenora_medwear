# Velenora Medwear — Environment Variables
# Copy this file to .env and configure with your Supabase credentials when ready.

# Supabase Public API (Browser Safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: The application operates gracefully in offline/local mock mode with complete 
# realistic seed data if these variables are empty. When filled, it links to your live Supabase database.
# NEVER place service-role keys in this file.
